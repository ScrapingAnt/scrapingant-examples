vars: {
  d2-config: {
    pad: 24
    theme-overrides: {
      B1: "#FF6B35"
      B2: "#333333"
      B3: "#5A5A5A"
      B4: "#DDDDDD"
      B5: "#EFEFEF"
      B6: "#F7F7F7"
      AA2: "#FF6B35"
      AA4: "#FFE3D6"
      AA5: "#E64D1E"
      AB4: "#2F6FED"
      AB5: "#DCE7FF"
    }
  }
}
classes: {
  group: {style: {fill: "#FFF7F3"; stroke: "#FF6B35"; stroke-width: 2; border-radius: 10; font-size: 22; bold: true; font-color: "#333333"}}
  box: {style: {fill: "#FFFFFF"; stroke: "#B8B8B8"; stroke-width: 1; border-radius: 8; font-size: 19; font-color: "#333333"}}
  emph: {style: {fill: "#FF6B35"; stroke: "#E64D1E"; stroke-width: 1; border-radius: 8; font-size: 19; font-color: "#FFFFFF"; bold: true}}
  soft: {style: {fill: "#F3F3F3"; stroke: "#CFCFCF"; stroke-width: 1; border-radius: 8; font-size: 17; font-color: "#333333"}}
  edge: {style: {stroke: "#5A5A5A"; stroke-width: 2; font-size: 17; font-color: "#444444"}}
  edgeo: {style: {stroke: "#FF6B35"; stroke-width: 2; font-size: 17; font-color: "#C2410C"; bold: true}}
  note: {style: {fill: "#FFFFFF"; stroke: "#FFFFFF"; font-size: 16; font-color: "#555555"}; shape: text}
}
